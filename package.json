{
  "name": "talo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "dependencies": {
    "@mysten-incubation/memwal": "0.1.11",
    "@mysten/seal": "1.5.2",
    "@mysten/sui": "2.38.0",
    "@mysten/walrus": "1.2.37",
    "@neon/config": "1.9.5",
    "@neon/env": "1.6.6",
    "@neondatabase/serverless": "1.2.0",
    "@vinext/cloudflare": "1.2.1",
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:providers": "node scripts/check-providers.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}

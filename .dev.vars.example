# Copy to .dev.vars and fill locally. Never paste credentials into chat.
# The local app works in fixture mode without provider credentials.
TALO_DEMO_MODE=true
TALO_DIAGNOSTICS_ENABLED=false
DATABASE_URL=
TATUM_API_KEY=
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
# Required only for a live Tatum transaction check. Use a known Mainnet digest.
TATUM_TRANSACTION_DIGEST=
# Generate locally: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Required for diagnostic API access when enabled.
DIAGNOSTICS_TOKEN=

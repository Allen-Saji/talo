# Copy to .dev.vars and fill locally. Never paste credentials into chat.
# The local app works in fixture mode without provider credentials.
TALO_DEMO_MODE=true
TALO_DIAGNOSTICS_ENABLED=false
# `neon deploy` downloads DATABASE_URL and DATABASE_URL_UNPOOLED to .env.local.
# Vite syncs the pooled DATABASE_URL here before local dev/build.
DATABASE_URL=
TATUM_API_KEY=
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Required only for a live Tatum transaction check. Use a known Mainnet digest.
TATUM_TRANSACTION_DIGEST=
# Generate locally: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Required for diagnostic API access when enabled.
DIAGNOSTICS_TOKEN=

# Optional OpenAI answer generation (server-only, gpt-6-luna).
OPENAI_API_KEY=

# Public email/password authentication. Local fixture mode is ignored when true.
TALO_PUBLIC_AUTH=false
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Lesson reviewers: exact verified account emails or server-derived IDs.
TALO_OPERATOR_EMAILS=
TALO_OPERATOR_IDS=

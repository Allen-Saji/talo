{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talo-knowledge-import",
  "main": "workers/knowledge-import.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
